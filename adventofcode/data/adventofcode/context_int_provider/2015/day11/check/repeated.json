{
    "type": "conditional",
    "condition": {
        "type": "int_value_check",
        "value": {
            "type": "storage",
            "storage": "adventofcode:2015/day11",
            "path": "characters[-2].value.number",
            "fallback": -1
        },
        "test": {
            "type": "storage",
            "storage": "adventofcode:2015/day11",
            "path": "characters[-1].value.number"
        }
    },
    "on_true": {
        "type": "add",
        "inputs": [
            {
                "type": "storage",
                "storage": "adventofcode:2015/day11",
                "path": "characters[-2].check.repeated"
            },
            1
        ]
    },
    "on_false": 1
}