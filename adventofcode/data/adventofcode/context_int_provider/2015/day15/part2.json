                        "inputs": [
                            {
                                "type": "storage",
                                "storage": "adventofcode:2015/day15",
                                "path": "stack[-1].durability"
                            },
                            0
                        ]
                    },
                    {
                        "type": "max",
                        "inputs": [
                            {
                                "type": "storage",
                                "storage": "adventofcode:2015/day15",
                                "path": "stack[-1].flavor"
                            },
                            0
                        ]
                    },
                    {
                        "type": "max",
                        "inputs": [
                            {
                                "type": "storage",
                                "storage": "adventofcode:2015/day15",
